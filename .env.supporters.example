# Required: SVG credits use active Ko-fi payments and dated grants in Supabase.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
# No Google Sheet is needed. Never commit real service credentials.

# Optional destination for the episode-named SVG copy (default: ~/Downloads)
# SUPPORTERS_DOWNLOADS_DIR="/path/to/downloads"
# Database failures stop generation by default. Explicit manual stale fallback:
# SUPPORTERS_ALLOW_STALE_ON_FETCH_ERROR="true"

# Explicit offline CSV fixtures only; never an automatic production fallback.
# SUPPORTERS_CSV_FILE="./supporters.csv"
# SUPPORTERS_NAME_COLUMN="2"
# SUPPORTERS_CIV_COLUMN="3"
