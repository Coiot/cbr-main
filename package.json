{
  "name": "vuepress-blog",
  "description": "Civ Battle Royale episode archive and community site",
  "version": "0.11.0-beta",
  "license": "MIT",
  "engines": {
    "node": ">=20.19 <23"
  },
  "resolutions": {
    "js-yaml": "^3.15.0",
    "vite": "^7.3.5"
  },
  "scripts": {
    "predev": "npm run build:album-data",
    "dev": "vuepress dev src",
    "build:album-data": "node scripts/build-album-data.js",
    "build:social-card": "node scripts/build-home-social-card.js",
    "build:episode-snapshots": "node scripts/build-episode-snapshots.js",
    "build": "npm run build:album-data && npm run build:social-card && npm run build:episode-snapshots && vuepress build src",
    "build:map-cache": "node scripts/build-community-map-cache.js",
    "build:supporters": "node scripts/build-supporters-image.js",
    "test:site": "node scripts/test-site-behavior.mjs",
    "releases:setup": "python3 scripts/releases/setup.py install",
    "releases:uninstall": "python3 scripts/releases/setup.py uninstall",
    "releases:scan": ".venv-release/bin/python scripts/releases/intake.py scan",
    "releases:retry": ".venv-release/bin/python scripts/releases/intake.py retry",
    "releases:status": ".venv-release/bin/python scripts/releases/intake.py status",
    "releases:check": ".venv-release/bin/python scripts/releases/intake.py check",
    "releases:terminology": ".venv-release/bin/python scripts/releases/intake.py terminology",
    "releases:terminology-eval": ".venv-release/bin/python scripts/releases/intake.py terminology-eval",
    "releases:test": ".venv-release/bin/python -m unittest discover -s scripts/releases -p 'test_*.py'",
    "cdn:setup": "python3 scripts/cdn/setup.py install",
    "cdn:login": "python3 scripts/cdn/setup.py login",
    "cdn:configure": "python3 scripts/cdn/setup.py configure",
    "cdn:uninstall": "python3 scripts/cdn/setup.py uninstall",
    "cdn:dry-run": "python3 scripts/cdn/uploader.py dry-run",
    "cdn:smoke": "python3 scripts/cdn/smoke.py",
    "cdn:test": "python3 -m unittest discover -s scripts/cdn -p 'test_*.py'"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "medium-zoom": "^1.1.0",
    "nprogress": "^0.2.0",
    "prismjs": "^1.30.0",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@vuepress/bundler-vite": "2.0.0-rc.26",
    "dotenv": "^16.4.5",
    "sharp": "^0.35.0",
    "supabase": "^2.109.1",
    "vite": "^7.3.5",
    "vuepress": "2.0.0-rc.26",
    "yaml-front-matter": "^4.0.0"
  }
}
